# Kimi uses an OpenAI-compatible API. Keep the real key in backend/.env.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
# Use a model name currently available in your Kimi account.
KIMI_MODEL=kimi-k2.6
KIMI_ENABLED=true
KIMI_TIMEOUT_SECONDS=45
KIMI_TRUST_ENV=false
KIMI_PROXY=
# Reference-style Planner -> Retriever -> Verifier -> Writer -> Critic workflow.
KIMI_AGENT_WORKFLOW=structured
AGENT_MAX_TOOL_STEPS=8
# Session messages are persisted locally; sending them to Kimi is not enabled by default.
KIMI_SEND_SESSION_HISTORY=false

# Embeddings are disabled by default to avoid a first-request model download.
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MIN_SEMANTIC_SCORE=0.35
MIN_EVIDENCE_COVERAGE=0.3

# Set true only if you explicitly want an in-memory Qdrant instance.
QDRANT_IN_MEMORY=false
MAX_UPLOAD_BYTES=524288000
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_TRUST_ENV=false
TRANSCRIPT_CHUNK_SECONDS=30
TRANSCRIPT_CHUNK_MAX_CHARS=240
TRANSCRIPT_MAX_GAP_SECONDS=2
