# DeepSeek uses an OpenAI-compatible API. Keep the real key in backend/.env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ENABLED=true
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_TEMPERATURE=0.2
# Tool calling and Thinking mode are incompatible in the structured Agent.
# Leave this disabled for Planner/Verifier/Writer/Critic tool calls.
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_TRUST_ENV=false
DEEPSEEK_PROXY=
# Reference-style Planner -> Retriever -> Verifier -> Writer -> Critic workflow.
DEEPSEEK_AGENT_WORKFLOW=structured
AGENT_MAX_TOOL_STEPS=8
# Session messages are persisted locally; sending them to DeepSeek is not enabled by default.
DEEPSEEK_SEND_SESSION_HISTORY=false

# Embeddings are disabled by default to avoid a first-request model download.
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MIN_SEMANTIC_SCORE=0.35
MIN_EVIDENCE_COVERAGE=0.3

# Set true only if you explicitly want an in-memory Qdrant instance.
QDRANT_IN_MEMORY=false
REPORT_TIMEOUT_SECONDS=180
DEEPSEEK_ENABLE_VERIFIER_AUDIT=false
DEEPSEEK_LLM_PLANNER_ENABLED=false
MAX_UPLOAD_BYTES=524288000
OCR_ENABLED=true
OCR_INTERVAL_SECONDS=15
PADDLEOCR_MAX_FRAMES=40
PADDLEOCR_FRAME_MAX_WIDTH=960
PADDLEOCR_CONFIDENCE_THRESHOLD=0.65
PADDLEOCR_DEDUP_THRESHOLD=0.88
PADDLEOCR_MODEL_ROOT=data/models/paddlex
PADDLE_HOME=data/models/paddle
PADDLEOCR_MODEL_SOURCE=bos
PADDLEOCR_DEVICE=cpu
PADDLEOCR_CPU_THREADS=4
# Paddle 3.x + oneDNN currently fails on some Windows CPU installations.
PADDLEOCR_ENABLE_MKLDNN=false
WHISPER_MODEL=base
WHISPER_FALLBACK_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_LANGUAGE=zh
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_MODEL_ROOT=data/models/whisper
WHISPER_INITIAL_PROMPT=
WHISPER_HOTWORDS=
WHISPER_TRUST_ENV=false
# 0 means no fixed time slicing; blocks follow pauses, punctuation and text length.
TRANSCRIPT_CHUNK_SECONDS=0
TRANSCRIPT_CHUNK_MAX_CHARS=240
TRANSCRIPT_MAX_GAP_SECONDS=2

# External services (docker-compose.infra.yml)
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/tracelens?charset=utf8mb4
AUTH_REQUIRED=true
# Use a unique random value of at least 32 characters outside this example file.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_HOURS=24
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REDIS_URL=redis://127.0.0.1:6379/0
ROCKETMQ_NAMESERVER=127.0.0.1:9876
ROCKETMQ_TOPIC=tracelens-video-tasks
ROCKETMQ_ENABLED=false
ROCKETMQ_PRODUCER_GROUP=tracelens-python-producer
ROCKETMQ_CONSUMER_GROUP=tracelens-python-consumer
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
BILIBILI_IMPORT_ENABLED=true
BILIBILI_MAX_DURATION_SECONDS=900
BILIBILI_MAX_FILE_BYTES=536870912
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8001
TRACELENS_API_URL=http://127.0.0.1:9090
TRACELENS_MCP_TOKEN=
